# Runtime settings for the Next.js standalone server on Elastic Beanstalk.
# PORT is provided by the platform (8080); nginx proxies port 80 to it.
# Secrets (GROQ_API_KEY, SMTP_*, etc.) are NOT set here - add them as
# environment properties in the Elastic Beanstalk console.
option_settings:
  aws:elasticbeanstalk:application:environment:
    HOSTNAME: 0.0.0.0
    NEXT_TELEMETRY_DISABLED: "1"
